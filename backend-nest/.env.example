# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=logoca
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT
JWT_SECRET=super-secret-jwt-key-change-in-prod
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-refresh-key
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=logoca.exchange
RABBITMQ_QUEUE_ORDERS=orders.queue
RABBITMQ_QUEUE_NOTIFICATIONS=notifications.queue
RABBITMQ_DLQ=orders.dlq

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=logoca-nest
KAFKA_GROUP_ID=logoca-admin-group
KAFKA_TOPIC_ORDERS=logoca.orders
KAFKA_TOPIC_NOTIFICATIONS=logoca.notifications
KAFKA_TOPIC_ADMIN=logoca.admin.events

# Apache Ignite
IGNITE_HOST=127.0.0.1
IGNITE_PORT=10800
IGNITE_USER_CACHE=user-cache
IGNITE_ADMIN_CACHE=admin-cache
IGNITE_USER=
IGNITE_PASSWORD=

# Business Rules
PRODUCT_MARKUP_PERCENT=20
MIN_ORDER_QUANTITY=1
FREIGHT_BASE_PRICE=15.00
FREIGHT_PRICE_PER_KM=1.20
FREIGHT_PRICE_PER_KG=0.80
