# LogoCá FastAPI — .env.example (copie para .env)
ENV=development
PORT=8000
LOG_LEVEL=debug
ENABLE_SWAGGER=true

# Postgres (asyncpg)
DATABASE_URL=postgresql+asyncpg://logoca:logoca123@localhost:5432/logoca_db
# Alternativa postgres:// também aceita (auto-converte)
# DATABASE_URL=postgres://logoca:logoca123@localhost:5432/logoca_db

# Redis
REDIS_URL=redis://:redis123@localhost:6379/0
REDIS_PASSWORD=redis123

# Ignite
IGNITE_HOST=localhost
IGNITE_PORT=10800
IGNITE_CACHE_USER=user-cache
IGNITE_CACHE_ADMIN=admin-cache

# RabbitMQ (user→empresa)
RABBITMQ_URL=amqp://logoca:logoca123@localhost:5672/
RABBITMQ_USER=logoca
RABBITMQ_PASSWORD=logoca123

# Kafka (admin eventos)
KAFKA_BROKERS=localhost:9092
KAFKA_ZOOKEEPER_CONNECT=localhost:2181

# JWT
JWT_SECRET=super-secret-jwt-logoca-2024-troque-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super-secret-refresh-logoca-2024
BCRYPT_ROUNDS=10

# CORS
CORS_ORIGIN=http://localhost:4200,http://localhost:3001
