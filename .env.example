# =============================================================================
# LogoCá Logísticas — .env.example
# Copie para .env e ajuste os valores:  cp .env.example .env
# =============================================================================

# ── Ambiente ────────────────────────────────────────────────────────────────
NODE_ENV=development
ENV=development

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=logoca
POSTGRES_PASSWORD=logoca123
POSTGRES_DB=logoca_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://logoca:logoca123@localhost:5432/logoca_db?schema=public
# NestJS (formato postgres://) — mesma credencial
# DATABASE_URL_NEST=postgres://logoca:logoca123@localhost:5432/logoca_db

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis123
REDIS_PORT=6379
REDIS_URL=redis://:redis123@localhost:6379
REDIS_URL_FASTAPI=redis://:redis123@localhost:6379/0

# ── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=logoca
RABBITMQ_PASSWORD=logoca123
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://logoca:logoca123@localhost:5672
RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# ── Kafka ─────────────────────────────────────────────────────────────────
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
# Dentro do Docker compose o broker é kafka:29092
KAFKA_BROKERS_DOCKER=kafka:29092
KAFKA_ZOOKEEPER_CONNECT=localhost:2181

# ── Apache Ignite ───────────────────────────────────────────────────────────
IGNITE_PORT=10800
IGNITE_URL=localhost:10800
IGNITE_HOST=localhost
IGNITE_CACHE_USER=user-cache
IGNITE_CACHE_ADMIN=admin-cache

# ── JWT / Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=super-secret-jwt-logoca-2024-troque-em-producao
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super-secret-refresh-logoca-2024
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# ── Backends ────────────────────────────────────────────────────────────────
NEST_PORT=3000
FASTAPI_PORT=8000
DJANGO_PORT=8001
NEST_API_URL=http://localhost:3000
FASTAPI_API_URL=http://localhost:8000
DJANGO_API_URL=http://localhost:8001

# ── Frontends ───────────────────────────────────────────────────────────────
ANGULAR_PORT=4200
NEXT_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NG_API_URL=http://localhost:3000

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200,http://localhost:3001

# ── Email / Notificações ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=logocalogisticas@contato.com
SMTP_PASS=troque-a-senha
SMTP_FROM="LogoCá Logísticas <logocalogisticas@contato.com>"
CONTACT_EMAIL=logocalogisticas@contato.com

# ── Observabilidade ─────────────────────────────────────────────────────────
LOG_LEVEL=debug
ENABLE_SWAGGER=true
